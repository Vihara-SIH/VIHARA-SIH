VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

VITE_N8N_LOGIN_WEBHOOK_URL=your_n8n_login_webhook_url_here

# ─── Server-Side Only (Vercel Environment Variables / functions/.env) ───
# These are NOT prefixed with VITE_ and are NEVER exposed to the browser.
# Set them in Vercel Dashboard > Settings > Environment Variables for production.
# For local dev, the Vite dev middleware reads them from this .env file via loadEnv().

# Required for AI Concierge chat
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model (default: gemini-3.6-flash with automatic fallback)
# GEMINI_MODEL=gemini-3.6-flash

# Canonical variable for live Google Maps, Places, Geocoding, Nearby & Routes
# (GOOGLE_PLACES_API_KEY is also accepted as a backwards-compatible alias)
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Canonical variable for n8n itinerary email webhook
# (N8N_ITINERARY_WEBHOOK_URL is also accepted as a backwards-compatible alias)
# N8N_WEBHOOK_URL=your_n8n_webhook_url_here
