# ==============================================================================
# VIHARA Backend Cloud Functions - Environment Configuration Example
# ==============================================================================
#
# IMPORTANT:
# - Do NOT add real production secrets to this file or commit your .env to git.
# - In local development: Copy this file to `functions/.env` and add your Gemini API Key.
# - In Firebase Cloud Functions deployment: Set the secret in Firebase Secret Manager:
#     firebase functions:secrets:set GEMINI_API_KEY
#
# ==============================================================================

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model selection (default: gemini-3.6-flash, with automatic fallback to gemini-3.5-flash)
GEMINI_MODEL=gemini-3.6-flash

